# Variáveis de ambiente do projeto.
# Copie este arquivo para .env e preencha os valores (o Prisma CLI lê apenas
# o arquivo .env, conforme configurado em prisma.config.ts).

# --- Banco de dados (Prisma / PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/msica?schema=public"

# --- Seções abaixo serão utilizadas em etapas futuras do desenvolvimento ---

# --- Auth.js ---
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"

# --- Spotify (OAuth + importação de dados públicos) ---
# SPOTIFY_CLIENT_ID=""
# SPOTIFY_CLIENT_SECRET=""

# --- MusicBrainz ---
# MUSICBRAINZ_USER_AGENT="msica/0.1.0 ( contato@exemplo.com )"
