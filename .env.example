# Variáveis de ambiente do projeto.
# Copie este arquivo para .env.local e preencha os valores.
# As seções abaixo serão utilizadas em etapas futuras do desenvolvimento.

# --- Banco de dados (Prisma / PostgreSQL) ---
# DATABASE_URL="postgresql://user:password@localhost:5432/msica"

# --- Auth.js ---
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"

# --- Spotify (OAuth + importação de dados públicos) ---
# SPOTIFY_CLIENT_ID=""
# SPOTIFY_CLIENT_SECRET=""

# --- MusicBrainz ---
# MUSICBRAINZ_USER_AGENT="msica/0.1.0 ( contato@exemplo.com )"
